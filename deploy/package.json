{
    "name": "mediawork-mcp",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev -p 3004",
        "build": "next build",
        "start": "next start -p 3004",
        "start:test": "next start -p 3005",
        "build-and-start-test": "next build && next start -p 3005",
        "test": "pnpm exec playwright test",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "ts": "./node_modules/typescript-native/bin/tsc --noEmit --tsBuildInfoFile tsconfig.native.tsbuildinfo",
        "lint": "biome check",
        "fix": "biome check --write",
        "check": "pnpm ts & pid1=$!; pnpm lint & pid2=$!; wait $pid1; r1=$?; wait $pid2; r2=$?; exit $((r1 || r2))",
        "ci:lint": "biome ci"
    },
    "dependencies": {
        "@modelcontextprotocol/server": "2.0.0",
        "mcp-handler": "2.1.0",
        "next": "16.3.0-preview.8",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "server-only": "^0.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.7",
        "@modelcontextprotocol/client": "2.0.0",
        "@playwright/test": "^1.61.1",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "typescript": "^5.9.3",
        "typescript-native": "npm:typescript@7.0.2",
        "vitest": "^4.1.10"
    }
}
